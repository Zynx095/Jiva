# ============================================================
# JIVA ENVIRONMENT CONFIGURATION
# ============================================================

# --- MAPPING & ROUTING STACK (OPENSTREETMAP + VALHALLA / OSRM) ---
# Routing Provider: 'auto' (Valhalla -> OSRM -> Mock fallback), 'valhalla', 'osrm', or 'mock'
MAPPING_PROVIDER=auto

# Self-hosted / Local Valhalla service URL
VALHALLA_BASE_URL=http://localhost:8002

# Self-hosted / Local OSRM service URL (secondary fallback)
OSRM_BASE_URL=http://localhost:5000

# Mapping provider timeout in milliseconds
MAPPING_TIMEOUT_MS=5000


# --- SYSTEM & DEMO CONFIGURATION ---
ENVIRONMENT=local
PORT=4000
DEMO_MODE=true

# --- AWS & BEDROCK CONFIGURATION (OPTIONAL) ---
# Set USE_BEDROCK=true to use live Amazon Bedrock Claude 3.5 Sonnet instead of offline mock
USE_BEDROCK=false
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
